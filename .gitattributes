# 统一行尾，避免 Windows/Linux 协作时的噪声 diff
* text=auto eol=lf

# 二进制文件不做行尾转换
*.dll   binary
*.exe   binary
*.lib   binary
*.a     binary
*.pdb   binary
*.bin   binary
*.png   binary
*.jpg   binary

# 明确语法高亮
*.cs    text diff=csharp
*.c     text diff=c
*.h     text diff=c
*.md    text
*.ps1   text
*.py    text
